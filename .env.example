# Salin file ini menjadi .env dan isi kredensial Instagram
# JANGAN di-commit ke git!

IG_USERNAME=nama_akun_instagram
IG_PASSWORD=kata_sandi_instagram

# Image generation API
IMAGE_API_KEY=isi_api_key_di_sini
IMAGE_API_URL=https://bifrost.hcm-lab.id/v1/chat/completions
IMAGE_MODEL=Qwen/Qwen-Image-2.1
IMAGE_API_TIMEOUT=180
IMAGE_API_MODE=grid
IMAGE_API_GRID_WIDTH=768
IMAGE_API_GRID_HEIGHT=512
IMAGE_API_MAX_INPUT=384
IMAGE_API_WIDTH=512
IMAGE_API_HEIGHT=384
IMAGE_API_STEPS=8
IMAGE_API_JPEG_QUALITY=82
IMAGE_API_WORKERS=2

# qwen = remote cloud rendering; gatys_cpu = classical style transfer on CPU
PHOTOBOOTH_ENGINE=qwen
NST_ITERATIONS=200
NST_HEIGHT=320
NST_CONTENT_WEIGHT=100000
NST_STYLE_WEIGHT=30000
